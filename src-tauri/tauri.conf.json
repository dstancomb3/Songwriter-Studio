{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Songwriter Studio",
  "version": "0.1.0",
  "identifier": "com.dstancomb.songwriterstudio",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run desktop:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Songwriter Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
