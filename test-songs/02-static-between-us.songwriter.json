      "activeVersionId": "sbu-v2-v1",
      "versions": [
        {
          "id": "sbu-v2-v1",
          "name": "Default",
          "lyrics": "I used to dream about the ocean\nI used to want a house in June\nMy father kept a broken pocket watch\nAnd roses always die too soon\nAt the end of the day\nIt is what it is\nYou say my name",
          "chords": [
