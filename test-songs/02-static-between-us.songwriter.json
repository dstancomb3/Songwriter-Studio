        {
          "id": "sbu-chorus-v1",
          "name": "Default",
          "lyrics": "There's static between us\nA television in my head\nYou're reaching through the white noise\nI'm somewhere else instead\nThere's static between us\nAnd every signal turns to dust\nYou keep asking me to listen\nI keep losing both of us",
          "chords": [
