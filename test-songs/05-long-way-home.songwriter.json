    },
    {
      "id": "lwh-v2",
      "type": "verse",
      "title": "Verse 2",
      "activeVersionId": "lwh-v2-v1",
      "versions": [
        {
          "id": "lwh-v2-v1",
          "name": "Default",
          "lyrics": "Mrs. Carter's porch is painted yellow\nHer mailbox leans the way it always did\nThe corner store became a pharmacy\nThe vacant lot is full of someone's kids\nI almost stop beside the church\nWhere my mother sang soprano\nBut the parking lot is empty\nAnd I let the memory go",
          "chords": [
            "C",
            "G",
            "Am",
            "F"
          ],
          "melody": {
            "notes": []
          },
          "markers": [],
          "notes": ""
        }
      ]
    },
    {
      "id": "lwh-pre",
      "type": "pre-chorus",
      "title": "Pre-Chorus",
      "activeVersionId": "lwh-pre-v1",
      "versions": [
        {
          "id": "lwh-pre-v1",
          "name": "Default",
          "lyrics": "Every mile says keep on moving\nEvery landmark says remember",
          "chords": [
            "Dm",
            "F",
            "G"
          ],
          "melody": {
            "notes": []
          },
          "markers": [],
          "notes": ""
        }
      ]
    },
    {
      "id": "lwh-v3",
      "type": "verse",
      "title": "Verse 3",
      "activeVersionId": "lwh-v3-v1",
      "versions": [
        {
          "id": "lwh-v3-v1",
          "name": "Default",
          "lyrics": "My brother leaves the porch light burning\nThough I told him I might not arrive\nHe meets me barefoot in the driveway\nLike no time passed between our lives\nWe don't talk about the leaving\nWe don't count who should have called\nHe just takes my bag and tells me\nThere's still coffee after all",
          "chords": [
            "C",
            "G",
            "Am",
            "F"
          ],
          "melody": {
            "notes": []
          },
          "markers": [],
          "notes": ""
        }
      ]
    },
    {
      "id": "lwh-bridge",
      "type": "bridge",
      "title": "Bridge",
      "activeVersionId": "lwh-b-v1",
      "versions": [
        {
          "id": "lwh-b-v1",
          "name": "Default",
          "lyrics": "A town can keep your fingerprints\nWithout keeping your old room\nA road can bring you to the doorway\nIt can't tell you what to do\nSo I stand there in the porch light\nWith the engine ticking cold\nAnd for once I stop confusing\nBeing known with being old",
          "chords": [
            "Am",
            "F",
            "C",
            "G"
          ],
          "melody": {
            "notes": []
          },
          "markers": [],
          "notes": ""
        }
      ]
