      "type": "verse",
      "title": "Verse 1",
      "activeVersionId": "lwh-v1-a",
      "versions": [
        {
          "id": "lwh-v1-a",
          "name": "Default",
          "lyrics": "The water tower still wears the old name\nThe diner sign is missing half its red\nI pass the field where we learned how to drive\nAnd hear my father's warning in my head\nSlow down before the railroad\nWatch the curve beyond the mill\nFunny how a road remembers\nEven when the people don't stand still",
          "chords": [
            "C",
            "G",
            "Am",
            "F"
          ],
          "melody": {
            "notes": []
          },
          "markers": [],
          "notes": ""
        }
      ]
    },
    {
      "id": "lwh-chorus",
      "type": "chorus",
      "title": "Chorus",
      "activeVersionId": "lwh-c-b",
      "versions": [
        {
          "id": "lwh-c-a",
          "name": "Original",
          "lyrics": "I took the long way home\nPast every place I used to know\nThinking miles could turn me back\nTo someone I outgrew long ago\nI took the long way home\nTill the morning found the road\nMaybe home is what you carry\nWhen there's nowhere left to go",
          "chords": [
            "F",
            "C",
            "G",
            "Am"
          ],
          "melody": {
            "notes": []
          },
          "markers": [],
          "notes": ""
        },
        {
          "id": "lwh-c-b",
          "name": "Current",
          "lyrics": "I took the long way home\nPast every place I used to know\nThought the miles could turn me back\nTo someone I outgrew long ago\nI took the long way home\nTill the sunrise found the road\nMaybe home is what you carry\nWhen there's nowhere left to go",
          "chords": [
            "F",
            "C",
            "G",
            "Am"
          ],
          "melody": {
